@model RegisterVm
@{ViewData["Title"]="Register";}<div class="row justify-content-center"><div class="col-md-7 col-lg-6"><div class="card p-4"><h2 class="fw-bold">Join RaceDay</h2><p class="text-muted">Create an Organiser or Participant account.</p><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row"><div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control mb-3"/></div><div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control mb-3"/></div></div><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control mb-3"/><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control mb-3"/><label asp-for="Password" class="form-label"></label><input asp-for="Password" type="password" autocomplete="new-password" class="form-control mb-3"/><label asp-for="RoleName" class="form-label">Account type</label><select asp-for="RoleName" class="form-select mb-3"><option>Participant</option><option>Organiser</option></select><button class="btn btn-primary w-100">Create account</button></form></div></div></div>