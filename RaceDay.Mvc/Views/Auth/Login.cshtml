@model LoginVm
@{ViewData["Title"]="Login";}<div class="row justify-content-center"><div class="col-md-6 col-lg-5"><div class="card p-4"><h2 class="fw-bold">Welcome back</h2><p class="text-muted">Sign in to your RaceDay account.</p><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control mb-3"/><span asp-validation-for="Email" class="text-danger"></span><label asp-for="Password" class="form-label"></label><input asp-for="Password" type="password" autocomplete="current-password" class="form-control mb-3"/><span asp-validation-for="Password" class="text-danger"></span><button class="btn btn-primary w-100">Login</button></form><p class="mt-3 mb-0">New here? <a asp-action="Register">Create an account</a></p></div></div></div>