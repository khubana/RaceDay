@using System.Text.Json
@{ViewData["Title"]="Upcoming Events"; var events=ViewBag.Events as JsonElement?;}
<section class="hero"><div class="row align-items-center"><div class="col-lg-8"><p class="text-uppercase fw-bold small mb-2">The starting line is yours</p><h1 class="display-4 fw-bold">Find your next <span class="accent">finish line.</span></h1><p class="lead">Discover races, challenge yourself and make every kilometre count.</p><a class="btn btn-warning btn-lg" href="#events">Explore events</a></div><div class="col-lg-4 text-center display-1">🏃</div></div></section><div class="d-flex justify-content-between align-items-center mb-3" id="events"><div><h2 class="fw-bold">Upcoming events</h2><p class="text-muted">Choose a race and get ready to run.</p></div><div class="row g-2 mb-3"><div class="col-md-5"><label class="form-label" for="eventFilter">Search</label><input id="eventFilter" class="form-control" placeholder="Event name or location"/></div><div class="col-md-3"><label class="form-label" for="typeFilter">Event type</label><select id="typeFilter" class="form-select"><option value="">All types</option><option>Road</option><option>Trail</option><option>Fun Run</option><option>Marathon</option><option>Cross Country</option></select></div><div class="col-md-3"><label class="form-label" for="dateFilter">From date</label><input id="dateFilter" type="date" class="form-control"/></div></div><div class="row g-4" id="eventCards">@if(events.HasValue && events.Value.ValueKind==JsonValueKind.Array){@foreach(var e in events.Value.EnumerateArray().Where(x=>DateTime.TryParse(x.GetProperty("eventDate").ToString(),out var dt)&&dt.Date>=DateTime.Today)){<div class="col-md-6 col-lg-4"><div class="card h-100 event-card" data-search="@((e.GetProperty("eventName").ToString()+" "+e.GetProperty("eventLocation").ToString()).ToLowerInvariant())" data-type="@(e.TryGetProperty("eventType",out var et)?et.ToString():"")" data-date="@DateTime.Parse(e.GetProperty("eventDate").ToString()).ToString("yyyy-MM-dd")">@if(e.TryGetProperty("bannerImageUrl",out var img)&&img.ValueKind==JsonValueKind.String){<img src="@img.GetString()" class="card-img-top" style="height:180px;object-fit:cover"/>}else{<div class="event-placeholder">🏁</div>}<div class="card-body"><span class="badge text-bg-success mb-2">@e.GetProperty("eventStatus").ToString()</span><h5 class="fw-bold">@e.GetProperty("eventName").ToString()</h5><p class="text-muted">📍 @e.GetProperty("eventLocation").ToString()</p><p>@DateTime.Parse(e.GetProperty("eventDate").ToString()).ToString("dd MMM yyyy")</p><p>@e.GetProperty("eventDescription").ToString()</p><a class="btn btn-primary" asp-controller="Participant" asp-action="Details" asp-route-id="@e.GetProperty("eventID").GetInt32()">View event</a></div></div></div>}}else{<p class="text-muted">The events service is currently unavailable. Check that the Part 2 API is running.</p>}</div>

@section Scripts { <script>const search=document.getElementById("eventFilter"),type=document.getElementById("typeFilter"),date=document.getElementById("dateFilter");function filter(){const q=(search?.value||"").toLowerCase(),t=type?.value||"",d=date?.value||"";document.querySelectorAll(".event-card").forEach(c=>{const ok=c.dataset.search.includes(q)&&(!t||c.dataset.type===t)&&(!d||c.dataset.date>=d);c.closest(".col-md-6").style.display=ok?"":"none"})}search?.addEventListener("input",filter);type?.addEventListener("change",filter);date?.addEventListener("change",filter);</script> }
