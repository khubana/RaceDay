@using System.Text.Json
@{ViewData["Title"]="Enter Results";var items=ViewBag.Enrolments as JsonElement?;}<h1 class="fw-bold">Results entry</h1><p class="text-muted">Enter a finishing position and finish time for each enrolled participant after the event.</p><div class="card p-3"><table class="table"><thead><tr><th>Participant</th><th>Category</th><th>Status</th><th>Result</th></tr></thead><tbody>@if(items.HasValue&&items.Value.ValueKind==JsonValueKind.Array){@foreach(var x in items.Value.EnumerateArray()){<tr><td>@x.GetProperty("participantName").ToString()</td><td>@x.GetProperty("categoryName").ToString()</td><td>@x.GetProperty("status").ToString()</td><td><form asp-action="SaveResult" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@ViewBag.EventId"/><input type="hidden" name="enrolmentId" value="@x.GetProperty("enrolmentID").GetInt32()"/><input name="Position" type="number" min="1" placeholder="Position" class="form-control" required style="max-width:110px"/><input name="FinishTime" placeholder="01:25:30" class="form-control" style="max-width:140px"/><button class="btn btn-primary btn-sm">Save</button></form></td></tr>}}</tbody></table></div>