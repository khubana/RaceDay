@using System.Text.Json
@{
    ViewData["Title"] = "Event Categories";
    JsonElement? categories = ViewBag.Categories as JsonElement?;
    int eventId = (int)ViewBag.EventId;
}

<h1 class="fw-bold mb-4">Event categories</h1>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card p-3 h-100">
            <h5>Add a category</h5>
            <form asp-action="AddCategory" asp-route-id="@eventId" method="post">
                @Html.AntiForgeryToken()
                <label class="form-label" for="CategoryName">Category name</label>
                <input id="CategoryName" name="CategoryName" class="form-control mb-2"
                       maxlength="100" required />

                <label class="form-label" for="MaxParticipants">Maximum participants</label>
                <input id="MaxParticipants" name="MaxParticipants" type="number"
                       min="10" max="100000" value="100" class="form-control mb-2" required />

                <label class="form-label" for="EntryFee">Entry fee (R)</label>
                <input id="EntryFee" name="EntryFee" type="number" min="50"
                       max="1000000" step="0.01" value="50.00"
                       class="form-control mb-3" required />

                <button type="submit" class="btn btn-primary">Add category</button>
            </form>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card p-3">
            <h5>Available categories</h5>
            @if (categories.HasValue && categories.Value.ValueKind == JsonValueKind.Array)
            {
                var items = categories.Value.EnumerateArray().ToList();
                if (items.Count == 0)
                {
                    <p class="text-muted mb-0">No categories have been added to this event yet.</p>
                }
                else
                {
                    foreach (var category in items)
                    {
                        var categoryId = category.GetProperty("categoryID").GetInt32();
                        var name = category.GetProperty("categoryName").GetString();
                        var capacity = category.GetProperty("maxParticipants").GetInt32();
                        var fee = category.GetProperty("entryFee").GetDecimal();

                        <div class="border-bottom py-3 d-flex justify-content-between align-items-center gap-3">
                            <div>
                                <strong>@name</strong>
                                <div class="text-muted small">
                                    Capacity: @capacity · Entry fee: R @fee.ToString("F2")
                                </div>
                            </div>
                            <form asp-action="DeleteCategory" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@categoryId" />
                                <input type="hidden" name="eventId" value="@eventId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Delete this category?');">
                                    Delete
                                </button>
                            </form>
                        </div>
                    }
                }
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    Categories could not be loaded. Check that the RaceDay API is running and connected to the RaceDay database.
                </div>
            }
        </div>
    </div>
</div>
