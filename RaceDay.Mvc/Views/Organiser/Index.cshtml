@using System.Text.Json
@{ViewData["Title"]="Organiser Dashboard";var ev=ViewBag.Events as JsonElement?;var list=ev.HasValue&&ev.Value.ValueKind==JsonValueKind.Array?ev.Value.EnumerateArray().ToList():new List<JsonElement>();}<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="fw-bold">Organiser dashboard</h1><p class="text-muted">Your RaceDay event overview.</p></div><a class="btn btn-primary" asp-action="CreateEvent">＋ Create event</a></div><div class="row g-3 mb-4"><div class="col-md-4"><div class="card p-3"><p class="text-muted mb-1">Events in system</p><h2>@list.Count</h2></div></div><div class="col-md-4"><div class="card p-3"><p class="text-muted mb-1">Upcoming events</p><h2>@list.Count(x=>DateTime.TryParse(x.GetProperty("eventDate").ToString(),out var d)&&d.Date>=DateTime.Today)</h2></div></div><div class="col-md-4"><div class="card p-3"><p class="text-muted mb-1">Your role</p><h2>Organiser</h2></div></div></div><div class="card p-3"><h4>Your events</h4><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Enrolments</th></tr></thead><tbody>@foreach(var e in list){<tr><td>@e.GetProperty("eventName").ToString()</td><td>@DateTime.Parse(e.GetProperty("eventDate").ToString()).ToString("dd MMM yyyy")</td><td>@(((Dictionary<int,int>)ViewBag.EnrolmentCounts).GetValueOrDefault(e.GetProperty("eventID").GetInt32()))</td></tr>}</tbody></table></div><a asp-action="Events" class="btn btn-outline-primary align-self-start">Manage events</a></div>