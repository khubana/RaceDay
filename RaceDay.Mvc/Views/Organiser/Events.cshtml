@using System.Text.Json
@{ViewData["Title"]="Manage Events";var ev=ViewBag.Events as JsonElement?;}<div class="d-flex justify-content-between mb-3"><h1 class="fw-bold">Manage events</h1><a asp-action="CreateEvent" class="btn btn-primary">Create event</a></div><div class="card p-3"><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Status</th><th>Manage</th></tr></thead><tbody>@if(ev.HasValue&&ev.Value.ValueKind==JsonValueKind.Array){@foreach(var e in ev.Value.EnumerateArray()){<tr><td>@e.GetProperty("eventName").ToString()</td><td>@DateTime.Parse(e.GetProperty("eventDate").ToString()).ToString("dd MMM yyyy")</td><td>@e.GetProperty("eventLocation").ToString()</td><td><span class="badge text-bg-success">@e.GetProperty("eventStatus").ToString()</span></td><td class="d-flex gap-1"><a class="btn btn-sm btn-outline-primary" asp-action="EditEvent" asp-route-id="@e.GetProperty("eventID").GetInt32()">Edit</a><a class="btn btn-sm btn-outline-secondary" asp-action="Categories" asp-route-id="@e.GetProperty("eventID").GetInt32()">Categories</a><a class="btn btn-sm btn-outline-secondary" asp-action="Enrolments" asp-route-id="@e.GetProperty("eventID").GetInt32()">Enrolments</a><a class="btn btn-sm btn-outline-secondary" asp-action="Results" asp-route-id="@e.GetProperty("eventID").GetInt32()">Results</a><form asp-action="DeleteEvent" method="post"><input type="hidden" name="id" value="@e.GetProperty("eventID").GetInt32()"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this event?')">Delete</button></form></td></tr>}} </tbody></table></div></div>