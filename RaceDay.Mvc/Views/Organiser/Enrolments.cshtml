@using System.Text.Json
@{ViewData["Title"]="Event Enrolments";var items=ViewBag.Enrolments as JsonElement?;}<h1 class="fw-bold">Event enrolments</h1><div class="card p-3"><table class="table"><thead><tr><th>Participant</th><th>Email</th><th>Category</th><th>Status</th><th>Date</th></tr></thead><tbody>@if(items.HasValue&&items.Value.ValueKind==JsonValueKind.Array){@foreach(var x in items.Value.EnumerateArray()){<tr><td>@x.GetProperty("participantName").ToString()</td><td>@x.GetProperty("email").ToString()</td><td>@x.GetProperty("categoryName").ToString()</td><td><span class="badge status-@x.GetProperty("status").ToString().ToLower()">@x.GetProperty("status").ToString()</span></td><td>@x.GetProperty("enrolmentDate").ToString()</td></tr>}}</tbody></table></div>