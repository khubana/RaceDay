<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>@ViewData["Title"] - RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="~/css/site.css" rel="stylesheet"></head><body><nav class="navbar navbar-expand-lg navbar-dark bg-dark"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏁 RACEDAY</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav me-auto">@if(Context.Session.GetString("RoleName")=="Organiser"){<li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Index">Dashboard</a></li><li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Events">Manage Events</a></li>}else if(Context.Session.GetString("RoleName")=="Participant"){<li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Find Events</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My Events</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My Results</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a></li>}else{<li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Events</a></li>}</ul><div class="d-flex gap-2">@if(Context.Session.GetInt32("UserID").HasValue){<span class="navbar-text text-white">@Context.Session.GetString("Email")</span><form asp-controller="Auth" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Logout</button></form>}else{<a class="btn btn-outline-light btn-sm" asp-controller="Auth" asp-action="Login">Login</a><a class="btn btn-warning btn-sm" asp-controller="Auth" asp-action="Register">Register</a>}</div></div></div></nav><main class="container py-4"><partial name="_Alerts" />@RenderBody()</main><footer class="text-center py-4 text-muted">© @DateTime.Now.Year RaceDay · Run your race. Own your finish.</footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
