@using System.Text.Json
@{ViewData["Title"]="My Results";var items=ViewBag.Items as JsonElement?; string Ordinal(int n){var rem=n%100;if(rem>=11&&rem<=13)return $"{n}th";return (n%10) switch{1=>$"{n}st",2=>$"{n}nd",3=>$"{n}rd",_=>$"{n}th"};}}<h1 class="fw-bold">My race results</h1><div class="card p-3"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Position</th><th>Finish time</th><th>Score</th><th>Recorded</th></tr></thead><tbody>@if(items.HasValue&&items.Value.ValueKind==JsonValueKind.Array){@foreach(var x in items.Value.EnumerateArray()){<tr><td>@x.GetProperty("eventName").ToString()</td><td>@DateTime.Parse(x.GetProperty("eventDate").ToString()).ToString("dd MMM yyyy")</td><td>@x.GetProperty("categoryName").ToString()</td><td><b>@Ordinal(x.GetProperty("position").GetInt32())</b> out of @(x.TryGetProperty("totalFinishers",out var total)?total.ToString():"—")</td><td>@(x.GetProperty("finishTime").ValueKind==JsonValueKind.Null?"—":x.GetProperty("finishTime").ToString())</td><td>@x.GetProperty("score").ToString()</td><td>@x.GetProperty("recordedAt").ToString()</td></tr>}}</tbody></table></div>