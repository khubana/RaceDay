@using System.Text.Json
@{ViewData["Title"]="My Events";var items=ViewBag.Items as JsonElement?;}<h1 class="fw-bold">My events</h1><div class="card p-3"><table class="table"><thead><tr><th>Event</th><th>Category</th><th>Enrolled</th><th>Status</th><th></th></tr></thead><tbody>@if(items.HasValue&&items.Value.ValueKind==JsonValueKind.Array){@foreach(var x in items.Value.EnumerateArray()){<tr><td>@x.GetProperty("eventName").ToString()</td><td>@x.GetProperty("categoryName").ToString()</td><td>@DateTime.Parse(x.GetProperty("enrolmentDate").ToString()).ToString("dd MMM yyyy")</td><td><span class="badge status-@x.GetProperty("status").ToString().ToLower()">@x.GetProperty("status").ToString()</span></td><td><form asp-action="Cancel" method="post"><input type="hidden" name="id" value="@x.GetProperty("enrolmentID").GetInt32()"/><button class="btn btn-sm btn-outline-danger">Cancel</button></form></td></tr>}}</tbody></table></div>